[Unit]
Description=Ghost Acitivitypub Migrate
Requires=ghost_database.service
After=ghost_database.service

[Container]
ContainerName=ghost_activitypub_migrate
Image=ghcr.io/tryghost/activitypub-migrations:edge
AutoUpdate=registry
Network=ghost.network

Environment=MYSQL_DB=mysql://{{ db_user }}:{{ db_password }}@tcp(ghost_database:3306)/activitypub

[Service]
Restart=no
Type=oneshot
RemainAfterExit=yes